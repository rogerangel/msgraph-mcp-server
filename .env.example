# Identifiers, URLs and rollout controls only. Keep private keys/passwords in mounted secret files.
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_USER_OBJECT_ID=00000000-0000-0000-0000-000000000000
MCP_HOSTNAME=graph-mcp.example.ts.net
# Any HTTPS origin is supported; no external port is required by the application.
OPERATOR_BASE_URL=https://graph-operator.example.ts.net
# Keep false until the documented production If-Match test passes. Does not gate draft creation.
DRAFT_UPDATES_ENABLED=false
